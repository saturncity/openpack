(version 1)
# JLCPCB 4-layer standard capabilities (jlcpcb.com/capabilities/pcb-capabilities, 1 oz outer / 0.5 oz inner).
# These are the fab's limits. The router works to larger values (0.15 clearance, 0.2 track, 0.6/0.3 via),
# so passing here leaves margin for DFM. Numbers: hw/REVIEW.md (pack section).

(rule "JLC track width"
  (constraint track_width (min 0.09mm)))

(rule "JLC copper clearance"
  (constraint clearance (min 0.09mm)))

(rule "JLC via"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.25mm))
  (constraint annular_width (min 0.075mm)))

(rule "JLC PTH"
  (condition "A.Type == 'Pad' && A.isPlated()")
  (constraint hole_size (min 0.15mm) (max 6.3mm))
  (constraint annular_width (min 0.1mm)))

(rule "JLC NPTH"
  (condition "A.Type == 'Pad' && !A.isPlated()")
  (constraint hole_size (min 0.5mm)))

(rule "JLC hole to hole"
  (constraint hole_to_hole (min 0.25mm)))

(rule "JLC copper to edge"
  (constraint edge_clearance (min 0.3mm)))

(rule "JLC silkscreen"
  (layer "?.Silkscreen")
  (constraint text_height (min 0.8mm))
  (constraint text_thickness (min 0.15mm)))

# Every SMD GND pad has its own via to the L2 plane (layout.py gnd_fanout), so one thermal spoke
# into the L1 pour is enough.
(rule "GND thermal spokes"
  (constraint min_resolved_spokes (min 1)))

# RF_50R: 50 ohm microstrip on L1 over the L2 plane, JLC04161H-7628 (h 0.2104 mm, er 4.4, 35 um):
# w = 0.346 mm (layout.py width_for). No carrier RF trace on this board: the BT40NE's nRF21540 -> u.FL
# path is inside the module. Kept for the BT40N fallback (ADR-0007), which needs a pad -> u.FL trace.
(rule "RF_50R"
  (condition "A.NetClass == 'RF_50R'")
  (constraint track_width (min 0.34mm) (opt 0.346mm) (max 0.36mm)))
