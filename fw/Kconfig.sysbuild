# #120: MCUboot on the app core has no hardware RNG (the app core has none; the nRF5340 RNG is on the
# net core, reached over HCI, which MCUboot lacks). RSA via PSA then selects the insecure
# TEST_RANDOM_GENERATOR. ECDSA-P256 only verifies, so it needs no RNG: default it on our boards.
# Declared before the stock choice so this default wins.
choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_ECDSA_P256 if $(BOARD) = "openpack_pack" || $(BOARD) = "openpack_rx"
endchoice

source "share/sysbuild/Kconfig"

config OP_ROLE_RX
	bool "Build the receiver role (default: pack); applied to app and net core images"
	default y if $(BOARD) = "openpack_rx"

config OP_TIME_DIVERSITY
	bool "Pack time diversity on at boot (ADR-0017); applied to app and net core images"

config NET_CORE_BOARD
	string
	default "nrf5340dk/nrf5340/cpunet" if $(BOARD) = "nrf5340dk"
	default "openpack_pack/nrf5340/cpunet" if $(BOARD) = "openpack_pack"
	default "openpack_rx/nrf5340/cpunet" if $(BOARD) = "openpack_rx"
	default "nrf5340bsim/nrf5340/cpunet" if $(BOARD_TARGET_STRING) = "NRF5340BSIM_NRF5340_CPUAPP"
