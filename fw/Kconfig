mainmenu "OpenPack firmware"

choice OP_ROLE
	prompt "Device role (FW-1)"
	default OP_ROLE_PACK

config OP_ROLE_PACK
	bool "Pack: transmitter worn by the performer"

config OP_ROLE_RX
	bool "Receiver module"

endchoice

# FW-5: every timing constant is Kconfig. Defaults from SPEC.md section 2 / AIR-4.
config OP_T_GAP_US
	int "Retune gap between copy A and copy B (us)"
	default 100

config OP_DAC_BLOCK_SAMPLES
	int "DAC DMA block (samples)"
	default 8

config OP_TIME_DIVERSITY
	bool "Time diversity on at boot (pack td setting, AIR-3 td_audio, RX-4, ADR-0017)"
	help
	  Packet n also carries frame n-2's codec_state + audio (td_audio, 39 B): 81 B payloads instead of
	  42 B, +2000 us latency (4.58 ms with PCM5102A FLT=1). Off by default (ADR-0017); a per-pack
	  configuration setting (td on|off, fw/PROTOCOL.md) for hostile venues, not switched mid-show.
	  The receiver needs no setting: it tells TD packs by payload length. Sysbuild: SB_CONFIG_OP_TIME_DIVERSITY.

config OP_RX_WINDOW_US
	int "Reserved RX window at the end of each frame (us)"
	default 0 if OP_TIME_DIVERSITY
	default 300
	help
	  AIR-4 / SYS-7 slot, idle in v1. Two 81 B TD copies end at t0 + 877 us, so a pack with TD on
	  forfeits it (ADR-0017): the TD build sets 0, and td on on a 300 us build sends into it.

config OP_PACK_ID
	int "Pack ID (AIR-2 access address), set from host/channel_plan.yaml"
	default 0
	range 0 7

config OP_CH_A_MHZ
	int "Copy A carrier (MHz, AIR-5)"
	default 2424
	range 2402 2440

config OP_CH_B_MHZ
	int "Copy B carrier (MHz, AIR-5: >= copy A + 40)"
	default 2473
	range 2442 2482
	help
	  2482 is UK/EU only (EN 300 328, ADR-0016); the pack's region setting caps fB at 2480 for us/jp
	  at runtime (fw/src/proto/proto_pack.c op_fb_max). BabbleSim's phy stops at 2480.

config OP_TEST_BSIM_ARGS
	bool "Test only: pack id and carriers from the bsim command line (-op_pack_id, -op_ch_a, -op_ch_b)"
	depends on ARCH_POSIX && SOC_COMPATIBLE_NRF5340_CPUNET
	default y
	help
	  bsim net core only (never on silicon): one build serves all 8 packs and receivers of the G2
	  scenarios (tests/bsim/scenarios, #27). Without the options the Kconfig values above apply.

config OP_PACK_FRAME_LEAD_US
	int "Pack: audio frame clock to net-core payload latch (us) = the frame thread's deadline (#87)"
	default 100
	range 1 499
	help
	  The app core places its 1 ms audio frame clock this far before the net core's latch
	  (OP_PACK_LATCH_LEAD_US before t0), from a sync the net core sends at start (ADR-0020). Read +
	  ADPCM-6 encode + IPC must finish inside it; then no frame is ever skipped. Every us here is
	  SYS-2 latency: SPEC section 2 "Encode + IPC" = this + OP_PACK_LATCH_LEAD_US. < 500: the net
	  core's margin report takes a frame within half a frame after its latch as late.

config OP_PACK_LATCH_LEAD_US
	int "Pack: net-core payload latch (TIMER0 COMPARE3) this far before TXEN of copy A (us, #98)"
	default 20
	range 5 100
	help
	  The newest frame is copied into the radio buffer this long before t0. It must follow the end
	  of copy B (t0 + 877 us at 81 B) and give the latch interrupt time before copy A's EasyDMA read
	  (t0 + ramp-up): 20 + 40 us. Every us here is SYS-2 latency (TD on with FLT=1: 4.6 ms budget).

config OP_PACK_FRAME_PRIO
	int "Pack: frame thread priority (cooperative, above the system workqueue)"
	default -2

config OP_TEST_SCHED_REPORT
	bool "Test only: pack prints PACK_IPC (net) / PACK_FCLK (app) lines per second"
	depends on ARCH_POSIX
	default y if OP_TEST_BSIM_ARGS || SOC_COMPATIBLE_NRF5340_CPUAPP
	help
	  tests/bsim/sched/check.py reads the margin (latch - frame arrival); tests/bsim/scenarios/run.py
	  (a) the device time of t0 and of the audio frame clock. bsim only, never silicon.

config OP_TEST_APP_LOAD_PERIOD_US
	int "Test only: app-core load thread wakes every this many us, 0 = off (tests/bsim/sched, #87)"
	default 0
	help
	  Stress for FW-2: an unrelated app-core thread that wakes periodically and busy-works for
	  OP_TEST_APP_LOAD_BUSY_US. The pack must not skip a frame. Never set in a shipped build.

config OP_TEST_APP_LOAD_BUSY_US
	int "Test only: busy time per load-thread wake (us)"
	default 0

config OP_TEST_APP_LOAD_PRIO
	int "Test only: load thread priority"
	default 7

config OP_TEST_PROTO_POLL_MS
	int "Test only: console thread polls its RX semaphore every this many ms, 0 = wait forever (#87)"
	default 0
	help
	  Brings back the 50 ms console poll that exposed #87. The shipped build waits forever.

# #107 / ADR-0015: nRF21540 front-end on the BT40NE (pack and receiver).
config OP_FEM_NRF21540
	bool "nRF21540 FEM present (devicetree node nrf_radio_fem)"
	default y if DT_HAS_NORDIC_NRF21540_FEM_ENABLED

config OP_FEM_ANT_SEL_UFL
	int "ANT_SEL (P1.05) logical level that selects the u.FL port"
	default 1
	range 0 1
	depends on OP_FEM_NRF21540
	help
	  UNVERIFIED. The Fanstel BT40/BT40N/NE spec v1.09 (p.21-22) wires P1.05 to the nRF21540 ANT_SEL but does not
	  say which port is the u.FL. Nordic: ANT_SEL low = ANT1, high = ANT2. Default 1 assumes the u.FL is on ANT2.
	  Confirm with Fanstel or on the bench (conducted power at the u.FL, P1.05 low vs high) before Phase 5.

config OP_FEM_GAIN_DB
	int "nRF21540 PA gain with MODE high (POUTB), dB"
	default 10
	depends on OP_FEM_NRF21540
	help
	  nRF21540 MODE high selects POUTB, about 10 dB gain (low selects POUTA, about 20 dB). The firmware always
	  drives MODE to POUTB: +7 dBm conducted needs only the low-gain path (ADR-0015, ~38 mA at +10 dBm).

config OP_TX_SOC_DBM
	int "nRF5340 radio TXPOWER (dBm, 1 dB steps -4..3)"
	default -3 if OP_FEM_NRF21540
	default 0
	range -4 3
	help
	  Without a FEM (native_sim, BabbleSim) this is the conducted power. With the FEM the conducted power is
	  this plus OP_FEM_GAIN_DB.

config OP_TX_MAX_CONDUCTED_DBM
	int "Conducted TX power ceiling (dBm)"
	default 7
	help
	  Region UK, ADR-0015: 9 dBm EIRP declared = +7 dBm conducted into the 2 dBi whip, 1 dB under the 10 dBm
	  EN 300 328 non-adaptive line. A build whose OP_TX_SOC_DBM (+ OP_FEM_GAIN_DB with a FEM) exceeds this does
	  not compile (fw/src/net/op_fem.h). Raise it only for a US-region build (ADR-0015, FCC 15.247).

# FW-2: the nRF5340 builds split work across cores over ipc0.
config OP_NRF5340
	bool
	default y if SOC_COMPATIBLE_NRF5340_CPUAPP || SOC_COMPATIBLE_NRF5340_CPUNET
	select IPC_SERVICE
	select MBOX

rsource "src/rx/Kconfig"
rsource "src/rx_app/Kconfig"

choice OP_AUDIO_BACKEND
	prompt "Audio I/O backend (FW-3)"
	default OP_AUDIO_I2S if BOARD_NRF5340DK
	default OP_AUDIO_WAV

config OP_AUDIO_WAV
	bool "WAV files on the host (native_sim, nrf5340bsim)"

config OP_AUDIO_I2S
	bool "I2S hardware (stub until Phase 5)"

endchoice

config OP_AUDIO_WAV_IN
	string "Input WAV (48 kHz mono 16-bit); env OP_AUDIO_IN overrides"
	default "op_in.wav"
	depends on OP_AUDIO_WAV

config OP_AUDIO_WAV_OUT
	string "Output WAV; env OP_AUDIO_OUT overrides"
	default "op_out.wav"
	depends on OP_AUDIO_WAV

source "Kconfig.zephyr"
