{
  "permissions": {
    "defaultMode": "auto",
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Edit",
      "Edit(.github/**)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(uv *)",
      "Bash(brew install *)",
      "Bash(brew upgrade *)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(actionlint *)",
      "Bash(west *)",
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(make *)",
      "Bash(docker *)",
      "Bash(kicad-cli *)",
      "Bash(kibot *)",
      "Bash(ngspice *)",
      "Bash(prusa-slicer *)",
      "Bash(sigrok-cli *)",
      "Bash(nrfjprog *)",
      "Bash(nrfutil *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(jq *)",
      "WebSearch",
      "WebFetch",
      "Bash(bazelisk *)",
      "Bash(bazel *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete *)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "autoContinueAtUsageLimit": true,
  "model": "opus"
}
